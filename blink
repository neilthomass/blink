#!/usr/bin/env bash
set -euo pipefail

# Blink - Block websites and their subdomains
# Discovers subdomains and writes them to /etc/hosts

EFFECTIVE_HOME="$HOME"
if [[ -n "${SUDO_USER:-}" ]]; then
    EFFECTIVE_HOME=$(eval echo "~${SUDO_USER}")
fi

if [[ -n "${BLINK_STATE_DIR:-}" ]]; then
    STATE_DIR="$BLINK_STATE_DIR"
elif [[ -n "${SUDO_USER:-}" ]]; then
    STATE_DIR="$EFFECTIVE_HOME/.local/state/blink"
else
    STATE_DIR="${XDG_STATE_HOME:-$EFFECTIVE_HOME/.local/state}/blink"
fi

BLOCKED_DOMAINS_FILE="$STATE_DIR/domains"
HARDLOCK_FILE="$STATE_DIR/hardlock"
CONFIG_FILE="$STATE_DIR/config"
HOSTS_FILE="/etc/hosts"
SUBDOMAIN_TOOL="${BLINK_SUBDOMAIN_TOOL:-sublist3r}"
HOSTS_MARKER="# blink:"
MATH_PROBLEMS=10

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

run_with_sudo() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    else
        sudo "$@"
    fi
}

ensure_sudo_available() {
    if [[ $EUID -ne 0 ]] && ! command -v sudo >/dev/null 2>&1; then
        echo -e "${RED}Error: sudo is required to modify /etc/hosts${NC}"
        exit 1
    fi
}

show_status() {
    echo -e "${YELLOW}blink${NC} - block websites from terminal"
    echo ""
    echo "Usage:"
    echo "  blink youtube.com      # Toggle block (prompts for sudo)"
    echo "  blink -s youtube.com   # Toggle block (soft lock)"
    echo "  blink --setup          # Configure math difficulty"
    echo ""

    if [[ ! -r "$BLOCKED_DOMAINS_FILE" ]]; then
        echo "State file not found. Run the installer or block a domain first."
        return
    fi

    if [[ ! -s "$BLOCKED_DOMAINS_FILE" ]]; then
        echo "No domains currently blocked"
        return
    fi

    echo "Blocked:"
    while read -r domain; do
        [[ -z "$domain" ]] && continue
        local lock_info=""
        if is_hardlocked "$domain"; then
            lock_info=" ${RED}[HARD]${NC}"
        fi
        echo -e "  - $domain$lock_info"
    done < "$BLOCKED_DOMAINS_FILE"
}

ensure_state_files() {
    mkdir -p "$STATE_DIR"
    touch "$BLOCKED_DOMAINS_FILE"
    ensure_hardlock_file
    ensure_config_file
}

require_subdomain_tool() {
    if ! command -v "$SUBDOMAIN_TOOL" >/dev/null 2>&1; then
        echo -e "${RED}Error: Required tool '$SUBDOMAIN_TOOL' not found${NC}"
        echo "Install Sublist3r (https://github.com/aboul3la/Sublist3r) or set BLINK_SUBDOMAIN_TOOL"
        exit 1
    fi
}

add_blocked_domain() {
    local domain="$1"
    grep -qx "$domain" "$BLOCKED_DOMAINS_FILE" 2>/dev/null || echo "$domain" >> "$BLOCKED_DOMAINS_FILE"
}

remove_blocked_domain() {
    local domain="$1"
    sed -i.bak "/^${domain}$/d" "$BLOCKED_DOMAINS_FILE" 2>/dev/null || true
    rm -f "${BLOCKED_DOMAINS_FILE}.bak"
}

is_blocked() {
    local domain="$1"
    grep -qx "$domain" "$BLOCKED_DOMAINS_FILE" 2>/dev/null
}

is_hardlocked() {
    local domain="$1"
    grep -q "^${domain}$" "$HARDLOCK_FILE" 2>/dev/null
}

ensure_hardlock_file() {
    if [[ ! -f "$HARDLOCK_FILE" ]]; then
        mkdir -p "$(dirname "$HARDLOCK_FILE")" 2>/dev/null || true
        touch "$HARDLOCK_FILE" 2>/dev/null || true
    fi
}

ensure_config_file() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        mkdir -p "$(dirname "$CONFIG_FILE")"
        echo "MATH_DIFFICULTY=2x2" > "$CONFIG_FILE"
    fi
}

discover_subdomains() {
    local domain="$1"
    local -a seeds=("www" "m" "mobile" "touch" "app" "apps" "secure" "login" "auth" "api" "cdn" "static")

    {
        echo "$domain"
        for seed in "${seeds[@]}"; do
            echo "${seed}.${domain}"
        done
        "$SUBDOMAIN_TOOL" -silent -d "$domain" 2>/dev/null || true
    } | sed 's/\r$//' | awk 'NF' | tr 'A-Z' 'a-z' | sort -u
}

write_hosts_block() {
    local domain="$1"
    shift
    local -a entries=("$@")
    local start_marker="# blink:start:${domain}"
    local end_marker="# blink:end:${domain}"

    remove_hosts_block "$domain"

    if [[ ${#entries[@]} -eq 0 ]]; then
        entries=("$domain")
    fi

    local tmp
    tmp=$(mktemp)
    {
        echo "$start_marker"
        for host in "${entries[@]}"; do
            [[ -z "$host" ]] && continue
            echo "127.0.0.1 $host ${HOSTS_MARKER}${domain}"
            echo "::1 $host ${HOSTS_MARKER}${domain}"
        done
        echo "$end_marker"
    } > "$tmp"

    ensure_sudo_available
    run_with_sudo tee -a "$HOSTS_FILE" < "$tmp" >/dev/null
    rm -f "$tmp"
}

remove_hosts_block() {
    local domain="$1"
    local start_marker="# blink:start:${domain}"
    local end_marker="# blink:end:${domain}"
    local tmp

    [[ -f "$HOSTS_FILE" ]] || return 0

    if ! grep -q "$start_marker" "$HOSTS_FILE" 2>/dev/null; then
        return 0
    fi

    tmp=$(mktemp)
    local skipping=0
    while IFS= read -r line; do
        if [[ "$line" == "$start_marker" ]]; then
            skipping=1
            continue
        fi
        if [[ "$line" == "$end_marker" ]]; then
            skipping=0
            continue
        fi
        if [[ $skipping -eq 0 ]]; then
            echo "$line"
        fi
    done < "$HOSTS_FILE" > "$tmp"

    ensure_sudo_available
    run_with_sudo install -m 644 "$tmp" "$HOSTS_FILE"
    rm -f "$tmp"
}

flush_dns_cache() {
    ensure_sudo_available

    if [[ "$(uname)" == "Darwin" ]]; then
        run_with_sudo dscacheutil -flushcache 2>/dev/null || true
        run_with_sudo killall -HUP mDNSResponder 2>/dev/null || true
    elif command -v systemd-resolve >/dev/null 2>&1; then
        run_with_sudo systemd-resolve --flush-caches 2>/dev/null || true
    elif command -v resolvectl >/dev/null 2>&1; then
        run_with_sudo resolvectl flush-caches 2>/dev/null || true
    elif command -v nscd >/dev/null 2>&1; then
        run_with_sudo nscd -i hosts 2>/dev/null || true
    fi
}

get_difficulty() {
    ensure_config_file
    grep "^MATH_DIFFICULTY=" "$CONFIG_FILE" 2>/dev/null | cut -d= -f2 || echo "times_tables"
}

setup_difficulty() {
    ensure_config_file

    echo ""
    echo -e "${YELLOW}=== Math Challenge Setup ===${NC}"
    echo ""
    echo "Choose difficulty for unlock challenges:"
    echo ""
    echo "  1) Times Tables  - Single digit (e.g., 7 × 8)"
    echo "  2) 2x2 Digits    - Two × two (e.g., 23 × 47)"
    echo "  3) 3x2 Digits    - Three × two (e.g., 234 × 56)"
    echo "  4) 3x3 Digits    - Three × three (e.g., 234 × 567)"
    echo ""

    local current
    current=$(get_difficulty)
    echo -e "Current: ${GREEN}$current${NC}"
    echo ""

    read -rp "Select [1-4]: " choice

    local difficulty
    case "$choice" in
        1) difficulty="times_tables" ;;
        2) difficulty="2x2" ;;
        3) difficulty="3x2" ;;
        4) difficulty="3x3" ;;
        *)
            echo -e "${RED}Invalid choice${NC}"
            return 1
            ;;
    esac

    sed -i.bak "s/^MATH_DIFFICULTY=.*/MATH_DIFFICULTY=$difficulty/" "$CONFIG_FILE"
    rm -f "${CONFIG_FILE}.bak"

    echo ""
    echo -e "${GREEN}Difficulty set to: $difficulty${NC}"
}

generate_problem() {
    local difficulty="$1"
    local a b answer

    case "$difficulty" in
        times_tables)
            a=$((RANDOM % 9 + 2))
            b=$((RANDOM % 9 + 2))
            ;;
        2x2)
            a=$((RANDOM % 90 + 10))
            b=$((RANDOM % 90 + 10))
            ;;
        3x2)
            a=$((RANDOM % 900 + 100))
            b=$((RANDOM % 90 + 10))
            ;;
        3x3)
            a=$((RANDOM % 900 + 100))
            b=$((RANDOM % 900 + 100))
            ;;
        *)
            a=$((RANDOM % 9 + 2))
            b=$((RANDOM % 9 + 2))
            ;;
    esac

    answer=$((a * b))
    echo "$a $b $answer"
}

math_challenge() {
    local domain="$1"
    local difficulty
    difficulty=$(get_difficulty)

    echo ""
    echo -e "${YELLOW}=== HARD LOCK ACTIVE ===${NC}"
    echo -e "To unblock ${RED}$domain${NC}, solve $MATH_PROBLEMS multiplication problems."
    echo -e "Difficulty: ${YELLOW}$difficulty${NC}"
    echo -e "Get any wrong and you start over."
    echo ""

    local correct=0
    while [[ $correct -lt $MATH_PROBLEMS ]]; do
        local problem
        problem=$(generate_problem "$difficulty")
        local a b answer
        a=$(echo "$problem" | cut -d' ' -f1)
        b=$(echo "$problem" | cut -d' ' -f2)
        answer=$(echo "$problem" | cut -d' ' -f3)

        echo -n "[$((correct + 1))/$MATH_PROBLEMS] $a × $b = "
        read -r user_answer

        if [[ "$user_answer" == "$answer" ]]; then
            correct=$((correct + 1))
            echo -e "${GREEN}Correct!${NC}"
        else
            echo -e "${RED}Wrong! The answer was $answer.${NC}"
            echo -e "${YELLOW}Starting over...${NC}"
            echo ""
            correct=0
            sleep 1
        fi
    done

    echo ""
    echo -e "${GREEN}Challenge complete!${NC}"
    return 0
}

block_domain() {
    local domain="$1"
    local soft="${2:-false}"

    ensure_state_files
    require_subdomain_tool
    ensure_sudo_available

    local -a subdomains=()
    while IFS= read -r line; do
        subdomains+=("$line")
    done < <(discover_subdomains "$domain")

    write_hosts_block "$domain" "${subdomains[@]}"
    add_blocked_domain "$domain"

    if [[ "$soft" != "true" ]]; then
        grep -qx "$domain" "$HARDLOCK_FILE" 2>/dev/null || echo "$domain" >> "$HARDLOCK_FILE"
    fi

    flush_dns_cache

    local total=${#subdomains[@]}
    if [[ "$soft" == "true" ]]; then
        echo -e "${GREEN}Blocked${NC} $domain (soft lock, ${total} hostnames)"
    else
        local difficulty
        difficulty=$(get_difficulty)
        echo -e "${RED}Blocked${NC} $domain (hard lock - $MATH_PROBLEMS math problems to unblock, ${total} hostnames)"
        echo -e "  Difficulty: ${YELLOW}$difficulty${NC}"
    fi
}

unblock_domain() {
    local domain="$1"

    ensure_state_files
    ensure_sudo_available

    # Check if hard locked - require math challenge
    if is_hardlocked "$domain"; then
        math_challenge "$domain" || return 1
        sed -i.bak "/^${domain}$/d" "$HARDLOCK_FILE"
        rm -f "${HARDLOCK_FILE}.bak"
    fi

    remove_hosts_block "$domain"
    remove_blocked_domain "$domain"
    flush_dns_cache

    echo -e "${GREEN}Unblocked${NC} $domain"
}

toggle_domain() {
    local domain="$1"
    local soft="${2:-false}"

    ensure_state_files

    if is_blocked "$domain"; then
        unblock_domain "$domain"
    else
        block_domain "$domain" "$soft"
    fi
}

uninstall_blink() {
    echo -e "${YELLOW}Uninstalling blink...${NC}"

    ensure_state_files
    ensure_sudo_available

    if [[ -f "$BLOCKED_DOMAINS_FILE" ]]; then
        while read -r domain; do
            [[ -z "$domain" ]] && continue
            remove_hosts_block "$domain"
        done < "$BLOCKED_DOMAINS_FILE"
    fi

    flush_dns_cache

    rm -rf "$STATE_DIR"
    run_with_sudo rm -f /usr/local/bin/blink

    echo -e "${GREEN}Blink uninstalled${NC}"
}

# Main
main() {
    if [[ $# -eq 0 ]]; then
        show_status
        exit 0
    fi

    case "${1:-}" in
        -h|--help)
            show_status
            exit 0
            ;;
        --setup)
            setup_difficulty
            exit 0
            ;;
        uninstall)
            uninstall_blink
            exit 0
            ;;
        -s|--soft)
            if [[ -z "${2:-}" ]]; then
                echo -e "${RED}Error: domain required${NC}"
                exit 1
            fi
            toggle_domain "$2" "true"
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}"
            show_status
            exit 1
            ;;
        *)
            toggle_domain "$1"
            ;;
    esac
}

main "$@"
