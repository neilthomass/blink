#!/usr/bin/env bash
set -euo pipefail

# Blink - Block websites and all their subdomains
# Uses dnsmasq for wildcard DNS blocking

BLOCKLIST_FILE="/etc/dnsmasq.d/blink-blocklist.conf"
HARDLOCK_FILE="/etc/blink/hardlock"
CONFIG_FILE="/etc/blink/config"
MATH_PROBLEMS=10

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

show_status() {
    echo -e "${YELLOW}blink${NC} - block websites from terminal"
    echo ""
    echo "Usage:"
    echo "  sudo blink youtube.com      # Toggle block (hard lock)"
    echo "  sudo blink -s youtube.com   # Toggle block (soft lock)"
    echo "  sudo blink --setup          # Configure math difficulty"
    echo ""

    ensure_blocklist_file
    ensure_hardlock_file

    local blocked
    blocked=$(grep "^address=/" "$BLOCKLIST_FILE" 2>/dev/null | sed 's/address=\/\(.*\)\/$/\1/' || true)

    if [[ -z "$blocked" ]]; then
        echo "No domains currently blocked"
    else
        echo "Blocked:"
        echo "$blocked" | while read -r domain; do
            local lock_info=""
            if is_hardlocked "$domain"; then
                lock_info=" ${RED}[HARD]${NC}"
            fi
            echo -e "  - $domain$lock_info"
        done
    fi
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}Error: blink requires root privileges${NC}"
        echo "Run with: sudo blink $*"
        exit 1
    fi
}

check_dnsmasq() {
    if ! command -v dnsmasq &> /dev/null; then
        echo -e "${RED}Error: dnsmasq is not installed${NC}"
        echo "Run the install script first"
        exit 1
    fi
}

ensure_blocklist_file() {
    if [[ ! -f "$BLOCKLIST_FILE" ]]; then
        mkdir -p "$(dirname "$BLOCKLIST_FILE")" 2>/dev/null || true
        touch "$BLOCKLIST_FILE" 2>/dev/null || true
        echo "# Blink blocklist - managed by blink CLI" > "$BLOCKLIST_FILE" 2>/dev/null || true
    fi
}

restart_dnsmasq() {
    if [[ "$(uname)" == "Darwin" ]]; then
        killall -HUP dnsmasq 2>/dev/null || true
        dscacheutil -flushcache 2>/dev/null || true
        killall -HUP mDNSResponder 2>/dev/null || true
    else
        systemctl restart dnsmasq 2>/dev/null || service dnsmasq restart 2>/dev/null || true
    fi
}

is_blocked() {
    local domain="$1"
    grep -q "^address=/${domain}/$" "$BLOCKLIST_FILE" 2>/dev/null
}

is_hardlocked() {
    local domain="$1"
    grep -q "^${domain}$" "$HARDLOCK_FILE" 2>/dev/null
}

ensure_hardlock_file() {
    if [[ ! -f "$HARDLOCK_FILE" ]]; then
        mkdir -p "$(dirname "$HARDLOCK_FILE")" 2>/dev/null || true
        touch "$HARDLOCK_FILE" 2>/dev/null || true
    fi
}

ensure_config_file() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        mkdir -p "$(dirname "$CONFIG_FILE")"
        echo "MATH_DIFFICULTY=2x2" > "$CONFIG_FILE"
    fi
}

get_difficulty() {
    ensure_config_file
    grep "^MATH_DIFFICULTY=" "$CONFIG_FILE" 2>/dev/null | cut -d= -f2 || echo "times_tables"
}

setup_difficulty() {
    ensure_config_file

    echo ""
    echo -e "${YELLOW}=== Math Challenge Setup ===${NC}"
    echo ""
    echo "Choose difficulty for unlock challenges:"
    echo ""
    echo "  1) Times Tables  - Single digit (e.g., 7 × 8)"
    echo "  2) 2x2 Digits    - Two × two (e.g., 23 × 47)"
    echo "  3) 3x2 Digits    - Three × two (e.g., 234 × 56)"
    echo "  4) 3x3 Digits    - Three × three (e.g., 234 × 567)"
    echo ""

    local current
    current=$(get_difficulty)
    echo -e "Current: ${GREEN}$current${NC}"
    echo ""

    read -rp "Select [1-4]: " choice

    local difficulty
    case "$choice" in
        1) difficulty="times_tables" ;;
        2) difficulty="2x2" ;;
        3) difficulty="3x2" ;;
        4) difficulty="3x3" ;;
        *)
            echo -e "${RED}Invalid choice${NC}"
            return 1
            ;;
    esac

    sed -i.bak "s/^MATH_DIFFICULTY=.*/MATH_DIFFICULTY=$difficulty/" "$CONFIG_FILE"
    rm -f "${CONFIG_FILE}.bak"

    echo ""
    echo -e "${GREEN}Difficulty set to: $difficulty${NC}"
}

generate_problem() {
    local difficulty="$1"
    local a b answer

    case "$difficulty" in
        times_tables)
            a=$((RANDOM % 9 + 2))
            b=$((RANDOM % 9 + 2))
            ;;
        2x2)
            a=$((RANDOM % 90 + 10))
            b=$((RANDOM % 90 + 10))
            ;;
        3x2)
            a=$((RANDOM % 900 + 100))
            b=$((RANDOM % 90 + 10))
            ;;
        3x3)
            a=$((RANDOM % 900 + 100))
            b=$((RANDOM % 900 + 100))
            ;;
        *)
            a=$((RANDOM % 9 + 2))
            b=$((RANDOM % 9 + 2))
            ;;
    esac

    answer=$((a * b))
    echo "$a $b $answer"
}

math_challenge() {
    local domain="$1"
    local difficulty
    difficulty=$(get_difficulty)

    echo ""
    echo -e "${YELLOW}=== HARD LOCK ACTIVE ===${NC}"
    echo -e "To unblock ${RED}$domain${NC}, solve $MATH_PROBLEMS multiplication problems."
    echo -e "Difficulty: ${YELLOW}$difficulty${NC}"
    echo -e "Get any wrong and you start over."
    echo ""

    local correct=0
    while [[ $correct -lt $MATH_PROBLEMS ]]; do
        local problem
        problem=$(generate_problem "$difficulty")
        local a b answer
        a=$(echo "$problem" | cut -d' ' -f1)
        b=$(echo "$problem" | cut -d' ' -f2)
        answer=$(echo "$problem" | cut -d' ' -f3)

        echo -n "[$((correct + 1))/$MATH_PROBLEMS] $a × $b = "
        read -r user_answer

        if [[ "$user_answer" == "$answer" ]]; then
            correct=$((correct + 1))
            echo -e "${GREEN}Correct!${NC}"
        else
            echo -e "${RED}Wrong! The answer was $answer.${NC}"
            echo -e "${YELLOW}Starting over...${NC}"
            echo ""
            correct=0
            sleep 1
        fi
    done

    echo ""
    echo -e "${GREEN}Challenge complete!${NC}"
    return 0
}

block_domain() {
    local domain="$1"
    local soft="${2:-false}"

    ensure_blocklist_file
    ensure_hardlock_file

    echo "address=/${domain}/" >> "$BLOCKLIST_FILE"

    if [[ "$soft" != "true" ]]; then
        echo "$domain" >> "$HARDLOCK_FILE"
    fi

    restart_dnsmasq

    if [[ "$soft" == "true" ]]; then
        echo -e "${GREEN}Blocked${NC} $domain (soft lock)"
    else
        local difficulty
        difficulty=$(get_difficulty)
        echo -e "${RED}Blocked${NC} $domain (hard lock - $MATH_PROBLEMS math problems to unblock)"
    fi
}

unblock_domain() {
    local domain="$1"

    # Check if hard locked - require math challenge
    if is_hardlocked "$domain"; then
        math_challenge "$domain" || return 1
        sed -i.bak "/^${domain}$/d" "$HARDLOCK_FILE"
        rm -f "${HARDLOCK_FILE}.bak"
    fi

    sed -i.bak "/^address=\/${domain}\/$/d" "$BLOCKLIST_FILE"
    rm -f "${BLOCKLIST_FILE}.bak"
    restart_dnsmasq

    echo -e "${GREEN}Unblocked${NC} $domain"
}

toggle_domain() {
    local domain="$1"
    local soft="${2:-false}"

    ensure_blocklist_file

    if is_blocked "$domain"; then
        unblock_domain "$domain"
    else
        block_domain "$domain" "$soft"
    fi
}

uninstall_blink() {
    echo -e "${YELLOW}Uninstalling blink...${NC}"

    # Remove config files
    rm -rf /etc/blink
    rm -f /etc/dnsmasq.d/blink-blocklist.conf
    rm -f /etc/dnsmasq.d/blink-config.conf
    rm -f /etc/dnsmasq.d/blink-hardlock.conf

    # Stop dnsmasq
    if [[ "$(uname)" == "Darwin" ]]; then
        pkill dnsmasq 2>/dev/null || true

        # Reset DNS
        networksetup -listallnetworkservices | tail -n +2 | while read -r service; do
            networksetup -setdnsservers "$service" empty 2>/dev/null || true
        done
        dscacheutil -flushcache 2>/dev/null || true
        killall -HUP mDNSResponder 2>/dev/null || true
    else
        systemctl stop dnsmasq 2>/dev/null || true
        rm -f /etc/systemd/resolved.conf.d/blink.conf 2>/dev/null || true
        chattr -i /etc/resolv.conf 2>/dev/null || true
        systemctl restart systemd-resolved 2>/dev/null || true
    fi

    # Remove blink CLI (self-destruct)
    rm -f /usr/local/bin/blink

    echo -e "${GREEN}Blink uninstalled${NC}"
}

# Main
main() {
    if [[ $# -eq 0 ]]; then
        show_status
        exit 0
    fi

    case "${1:-}" in
        -h|--help)
            show_status
            exit 0
            ;;
        --setup)
            check_root "$@"
            setup_difficulty
            exit 0
            ;;
        uninstall)
            check_root "$@"
            uninstall_blink
            exit 0
            ;;
        -s|--soft)
            if [[ -z "${2:-}" ]]; then
                echo -e "${RED}Error: domain required${NC}"
                exit 1
            fi
            check_root "$@"
            check_dnsmasq
            toggle_domain "$2" "true"
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}"
            show_status
            exit 1
            ;;
        *)
            check_root "$@"
            check_dnsmasq
            toggle_domain "$1"
            ;;
    esac
}

main "$@"
