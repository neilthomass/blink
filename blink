#!/usr/bin/env bash
set -euo pipefail

# Blink - Block websites and all their subdomains
# Uses dnsmasq for wildcard DNS blocking

BLOCKLIST_FILE="/etc/dnsmasq.d/blink-blocklist.conf"
HARDLOCK_FILE="/etc/dnsmasq.d/blink-hardlock.conf"
CONFIG_FILE="/etc/blink/config"
TIMER_DIR="/tmp/blink-timers"
MATH_PROBLEMS=10

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

usage() {
    cat << EOF
Usage: blink [OPTIONS] <domain> [duration]

Block websites and all their subdomains.

Arguments:
  domain      Domain to block (e.g., linkedin.com)
  duration    Optional: Block duration (e.g., 25m, 1h, 2h30m)

Options:
  -u, --unblock <domain>   Unblock a domain (requires math challenge)
  -s, --soft <domain>      Soft lock - no math challenge to unlock
  -l, --list               List all blocked domains
  --setup                  Configure math difficulty
  -h, --help               Show this help message

Examples:
  blink linkedin.com           # Block with hard lock (default)
  blink linkedin.com 25m       # Block for 25 minutes (hard lock)
  blink -s linkedin.com        # Soft lock (no math to unlock)
  blink -u linkedin.com        # Unblock (math challenge required)
  blink -l                     # List blocked domains
  blink --setup                # Configure difficulty
EOF
}

check_root() {
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}Error: blink requires root privileges${NC}"
        echo "Run with: sudo blink $*"
        exit 1
    fi
}

check_dnsmasq() {
    if ! command -v dnsmasq &> /dev/null; then
        echo -e "${RED}Error: dnsmasq is not installed${NC}"
        echo "Run the install script first: ./install.sh"
        exit 1
    fi
}

ensure_blocklist_file() {
    if [[ ! -f "$BLOCKLIST_FILE" ]]; then
        mkdir -p "$(dirname "$BLOCKLIST_FILE")"
        touch "$BLOCKLIST_FILE"
        echo "# Blink blocklist - managed by blink CLI" > "$BLOCKLIST_FILE"
    fi
}

restart_dnsmasq() {
    if [[ "$(uname)" == "Darwin" ]]; then
        brew services restart dnsmasq 2>/dev/null || sudo killall -HUP dnsmasq 2>/dev/null || true
    else
        systemctl restart dnsmasq 2>/dev/null || service dnsmasq restart 2>/dev/null || true
    fi
    # Flush DNS cache
    if [[ "$(uname)" == "Darwin" ]]; then
        dscacheutil -flushcache 2>/dev/null || true
        killall -HUP mDNSResponder 2>/dev/null || true
    fi
}

is_blocked() {
    local domain="$1"
    grep -q "^address=/${domain}/$" "$BLOCKLIST_FILE" 2>/dev/null
}

is_hardlocked() {
    local domain="$1"
    grep -q "^${domain}$" "$HARDLOCK_FILE" 2>/dev/null
}

ensure_hardlock_file() {
    if [[ ! -f "$HARDLOCK_FILE" ]]; then
        mkdir -p "$(dirname "$HARDLOCK_FILE")"
        touch "$HARDLOCK_FILE"
        echo "# Hard locked domains - require math challenge to unlock" > "$HARDLOCK_FILE"
    fi
}

ensure_config_file() {
    if [[ ! -f "$CONFIG_FILE" ]]; then
        mkdir -p "$(dirname "$CONFIG_FILE")"
        echo "MATH_DIFFICULTY=times_tables" > "$CONFIG_FILE"
    fi
}

get_difficulty() {
    ensure_config_file
    grep "^MATH_DIFFICULTY=" "$CONFIG_FILE" 2>/dev/null | cut -d= -f2 || echo "times_tables"
}

setup_difficulty() {
    ensure_config_file

    echo ""
    echo -e "${YELLOW}=== Math Challenge Setup ===${NC}"
    echo ""
    echo "Choose difficulty for unlock challenges:"
    echo ""
    echo "  1) Times Tables  - Single digit multiplication (e.g., 7 × 8)"
    echo "  2) 2x2 Digits    - Two-digit × two-digit (e.g., 23 × 47)"
    echo "  3) 3x2 Digits    - Three-digit × two-digit (e.g., 234 × 56)"
    echo "  4) 3x3 Digits    - Three-digit × three-digit (e.g., 234 × 567)"
    echo ""

    local current
    current=$(get_difficulty)
    echo -e "Current: ${GREEN}$current${NC}"
    echo ""

    read -rp "Select [1-4]: " choice

    local difficulty
    case "$choice" in
        1) difficulty="times_tables" ;;
        2) difficulty="2x2" ;;
        3) difficulty="3x2" ;;
        4) difficulty="3x3" ;;
        *)
            echo -e "${RED}Invalid choice${NC}"
            return 1
            ;;
    esac

    sed -i.bak "s/^MATH_DIFFICULTY=.*/MATH_DIFFICULTY=$difficulty/" "$CONFIG_FILE"
    rm -f "${CONFIG_FILE}.bak"

    echo ""
    echo -e "${GREEN}Difficulty set to: $difficulty${NC}"
}

# Generate math problem based on difficulty
generate_problem() {
    local difficulty="$1"
    local a b answer

    case "$difficulty" in
        times_tables)
            a=$((RANDOM % 9 + 2))   # 2-10
            b=$((RANDOM % 9 + 2))   # 2-10
            ;;
        2x2)
            a=$((RANDOM % 90 + 10))  # 10-99
            b=$((RANDOM % 90 + 10))  # 10-99
            ;;
        3x2)
            a=$((RANDOM % 900 + 100))  # 100-999
            b=$((RANDOM % 90 + 10))    # 10-99
            ;;
        3x3)
            a=$((RANDOM % 900 + 100))  # 100-999
            b=$((RANDOM % 900 + 100))  # 100-999
            ;;
        *)
            a=$((RANDOM % 9 + 2))
            b=$((RANDOM % 9 + 2))
            ;;
    esac

    answer=$((a * b))
    echo "$a $b $answer"
}

# Math challenge - must solve 10 problems to unlock
math_challenge() {
    local domain="$1"
    local difficulty
    difficulty=$(get_difficulty)

    echo ""
    echo -e "${YELLOW}=== HARD LOCK ACTIVE ===${NC}"
    echo -e "To unlock ${RED}$domain${NC}, solve $MATH_PROBLEMS multiplication problems."
    echo -e "Difficulty: ${YELLOW}$difficulty${NC}"
    echo -e "Get any wrong and you start over."
    echo ""

    local correct=0
    while [[ $correct -lt $MATH_PROBLEMS ]]; do
        local problem
        problem=$(generate_problem "$difficulty")
        local a b answer
        a=$(echo "$problem" | cut -d' ' -f1)
        b=$(echo "$problem" | cut -d' ' -f2)
        answer=$(echo "$problem" | cut -d' ' -f3)

        echo -n "[$((correct + 1))/$MATH_PROBLEMS] $a × $b = "
        read -r user_answer

        if [[ "$user_answer" == "$answer" ]]; then
            correct=$((correct + 1))
            echo -e "${GREEN}Correct!${NC}"
        else
            echo -e "${RED}Wrong! The answer was $answer.${NC}"
            echo -e "${YELLOW}Starting over...${NC}"
            echo ""
            correct=0
            sleep 1
        fi
    done

    echo ""
    echo -e "${GREEN}Challenge complete!${NC}"
    return 0
}

softlock_domain() {
    local domain="$1"
    local duration="${2:-}"

    ensure_blocklist_file

    if is_blocked "$domain"; then
        echo -e "${YELLOW}$domain is already blocked${NC}"
        return 0
    fi

    # Add to blocklist (blocks domain + ALL subdomains)
    echo "address=/${domain}/" >> "$BLOCKLIST_FILE"
    restart_dnsmasq

    echo -e "${GREEN}Soft blocked${NC} $domain (and all subdomains)"

    # Schedule unblock if duration specified
    if [[ -n "$duration" ]]; then
        schedule_unblock "$domain" "$duration"
    fi
}

block_domain() {
    local domain="$1"
    local duration="${2:-}"

    ensure_blocklist_file
    ensure_hardlock_file

    if is_blocked "$domain"; then
        echo -e "${YELLOW}$domain is already blocked${NC}"
        return 0
    fi

    # Add to blocklist (blocks domain + ALL subdomains)
    echo "address=/${domain}/" >> "$BLOCKLIST_FILE"

    # Hard lock by default
    if ! is_hardlocked "$domain"; then
        echo "$domain" >> "$HARDLOCK_FILE"
    fi

    restart_dnsmasq

    local difficulty
    difficulty=$(get_difficulty)
    echo -e "${RED}BLOCKED${NC} $domain (and all subdomains)"
    echo -e "Hard locked - requires $MATH_PROBLEMS math problems ($difficulty) to unlock"

    # Schedule unblock if duration specified
    if [[ -n "$duration" ]]; then
        schedule_unblock "$domain" "$duration"
    fi
}

unblock_domain() {
    local domain="$1"
    local skip_challenge="${2:-false}"

    if ! is_blocked "$domain"; then
        echo -e "${YELLOW}$domain is not blocked${NC}"
        return 0
    fi

    # Check if hard locked - require math challenge
    if [[ "$skip_challenge" != "true" ]] && is_hardlocked "$domain"; then
        math_challenge "$domain" || return 1

        # Remove from hardlock list
        sed -i.bak "/^${domain}$/d" "$HARDLOCK_FILE"
        rm -f "${HARDLOCK_FILE}.bak"
    fi

    # Remove from blocklist
    sed -i.bak "/^address=\/${domain}\/$/d" "$BLOCKLIST_FILE"
    rm -f "${BLOCKLIST_FILE}.bak"
    restart_dnsmasq

    # Cancel any scheduled unblock
    cancel_scheduled_unblock "$domain"

    echo -e "${GREEN}Unblocked${NC} $domain"
}

list_blocked() {
    ensure_blocklist_file

    local blocked
    blocked=$(grep "^address=/" "$BLOCKLIST_FILE" 2>/dev/null | sed 's/address=\/\(.*\)\/$/\1/' || true)

    if [[ -z "$blocked" ]]; then
        echo "No domains are currently blocked"
        return 0
    fi

    echo "Blocked domains:"
    ensure_hardlock_file
    echo "$blocked" | while read -r domain; do
        local timer_info=""
        local lock_info=""

        # Check for hard lock
        if is_hardlocked "$domain"; then
            lock_info=" ${RED}[HARD LOCKED]${NC}"
        fi

        # Check for timer
        if [[ -f "$TIMER_DIR/$domain" ]]; then
            local unblock_time
            unblock_time=$(cat "$TIMER_DIR/$domain")
            local remaining
            remaining=$(( unblock_time - $(date +%s) ))
            if [[ $remaining -gt 0 ]]; then
                local mins=$(( remaining / 60 ))
                local secs=$(( remaining % 60 ))
                timer_info=" (${mins}m ${secs}s remaining)"
            fi
        fi
        echo -e "  - $domain$lock_info$timer_info"
    done
}

parse_duration() {
    local duration="$1"
    local total_seconds=0

    # Parse hours
    if [[ "$duration" =~ ([0-9]+)h ]]; then
        total_seconds=$(( total_seconds + ${BASH_REMATCH[1]} * 3600 ))
    fi

    # Parse minutes
    if [[ "$duration" =~ ([0-9]+)m ]]; then
        total_seconds=$(( total_seconds + ${BASH_REMATCH[1]} * 60 ))
    fi

    # Parse seconds
    if [[ "$duration" =~ ([0-9]+)s ]]; then
        total_seconds=$(( total_seconds + ${BASH_REMATCH[1]} ))
    fi

    # If just a number, treat as minutes
    if [[ "$duration" =~ ^[0-9]+$ ]]; then
        total_seconds=$(( duration * 60 ))
    fi

    echo "$total_seconds"
}

schedule_unblock() {
    local domain="$1"
    local duration="$2"
    local seconds
    seconds=$(parse_duration "$duration")

    if [[ "$seconds" -le 0 ]]; then
        echo -e "${RED}Invalid duration: $duration${NC}"
        return 1
    fi

    mkdir -p "$TIMER_DIR"
    local unblock_time=$(( $(date +%s) + seconds ))
    echo "$unblock_time" > "$TIMER_DIR/$domain"

    # Schedule unblock in background
    (
        sleep "$seconds"
        if [[ -f "$TIMER_DIR/$domain" ]]; then
            /usr/local/bin/blink -u "$domain" 2>/dev/null || sudo blink -u "$domain"
            rm -f "$TIMER_DIR/$domain"
        fi
    ) &>/dev/null &
    disown

    local mins=$(( seconds / 60 ))
    echo -e "${YELLOW}Will unblock in ${mins} minutes${NC}"
}

cancel_scheduled_unblock() {
    local domain="$1"
    rm -f "$TIMER_DIR/$domain" 2>/dev/null || true
}

# Main
main() {
    if [[ $# -eq 0 ]]; then
        usage
        exit 1
    fi

    case "${1:-}" in
        -h|--help)
            usage
            exit 0
            ;;
        -l|--list)
            list_blocked
            exit 0
            ;;
        --setup)
            check_root "$@"
            setup_difficulty
            exit 0
            ;;
        -u|--unblock)
            if [[ -z "${2:-}" ]]; then
                echo -e "${RED}Error: domain required for unblock${NC}"
                exit 1
            fi
            check_root "$@"
            check_dnsmasq
            unblock_domain "$2"
            ;;
        -s|--soft)
            if [[ -z "${2:-}" ]]; then
                echo -e "${RED}Error: domain required for soft lock${NC}"
                exit 1
            fi
            check_root "$@"
            check_dnsmasq
            softlock_domain "$2" "${3:-}"
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}"
            usage
            exit 1
            ;;
        *)
            check_root "$@"
            check_dnsmasq
            block_domain "$1" "${2:-}"
            ;;
    esac
}

main "$@"
